# Miscellaneous
# Source PDFs (e.g. HSK textbooks used to write deck content) are working
# references, not app assets, and can exceed GitHub's 100MB file limit.
docs/resources/
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Git worktrees used for isolated feature work
.worktrees/

# Local Sentry Native crash-handler runtime cache (installation id, crash
# dumps, breadcrumbs) — machine-local state, never meant to be versioned.
.sentry-native/

# Locally installed Claude Code skills (via `npx skills add`), machine-local.
skills-lock.json
.claude/skills/
.agents/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
/android/.gradle/
