    { "id": "s4_p12", "original": "Ma femme entre dans la chambre.", "translation": "妻子进房间", "blocks": ["妻子", "进", "房间", "弟弟", "近", "穿"] },
    { "id": "s5_p12", "original": "Mon petit frère habite près de l'école.", "translation": "弟弟住得离学校很近", "blocks": ["弟弟", "住", "得", "离", "学校", "很", "近", "妻子", "远"] },
    { "id": "s6_p12", "original": "Il court plus vite que moi.", "translation": "他跑得比我快", "blocks": ["他", "跑", "得", "比", "我", "快", "慢", "穿", "近"] },
    { "id": "s7_p12", "original": "Elle s'habille très joliment.", "translation": "她穿得很漂亮", "blocks": ["她", "穿", "得", "很", "漂亮", "近", "雪", "妻子"] },
    { "id": "s8_p12", "original": "Mon petit frère est plus grand que moi.", "translation": "弟弟比我高", "blocks": ["弟弟", "比", "我", "高", "妻子", "近", "穿"] },
    { "id": "s9_p12", "original": "Il fait moins dix degrés aujourd'hui.", "translation": "今天零下十度", "blocks": ["今天", "零", "下", "十", "度", "冷", "雪", "穿"] },
    { "id": "s10_p12", "original": "Entre, s'il te plaît.", "translation": "请进", "blocks": ["请", "进", "近", "穿", "弟弟"] },
